# Copy this file to .env, then replace the placeholders.
# Never commit real connection strings, passwords, or auth secrets.

# Neon pooled connection string for application runtime (-pooler host).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Neon direct connection string for Prisma migrations (same branch/database, no -pooler).
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Generate a random secret with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Google sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional email delivery (SMTP or Resend).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_DEMO_RECIPIENT=""
